toast.TextXAlignment=Enum.TextXAlignment.Center
local toastCounter=0
remotes.Notify.OnClientEvent:Connect(function(message)
    toastCounter+=1; local id=toastCounter; toast.Text=tostring(message)
    task.delay(3,function() if toastCounter==id then toast.Text="" end end)
end)
-- Keyboard Shift and a touch button sprint; server still controls currency/rewards.
local stamina=Config.MaxStamina
local shiftDown=false
local touchSprint=false
local touchButton=button(gui,"SPRINT",UDim2.fromOffset(92,42),UDim2.new(1,-110,1,-105),function()
    touchSprint=not touchSprint
end)
touchButton.Visible=UIS.TouchEnabled
UIS.InputBegan:Connect(function(input,processed)
    if not processed and (input.KeyCode==Enum.KeyCode.LeftShift or input.KeyCode==Enum.KeyCode.RightShift) then shiftDown=true end
end)
UIS.InputEnded:Connect(function(input)
    if input.KeyCode==Enum.KeyCode.LeftShift or input.KeyCode==Enum.KeyCode.RightShift then shiftDown=false end
end)
RunService.Heartbeat:Connect(function(dt)
    local character=player.Character
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local moving=humanoid.MoveDirection.Magnitude>0.1
    local sprinting=(shiftDown or touchSprint) and moving and stamina>0 and humanoid.Health>0
    if sprinting then stamina=math.max(0,stamina-Config.StaminaDrainPerSecond*dt)
    else stamina=math.min(Config.MaxStamina,stamina+Config.StaminaRecoveryPerSecond*dt) end
    humanoid.WalkSpeed=sprinting and Config.SprintSpeed or Config.WalkSpeed
    bar.Size=UDim2.fromScale(stamina/Config.MaxStamina,1)
    barText.Text="STAMINA "..math.floor(stamina)
    if touchButton.Visible then touchButton.Text=touchSprint and "STOP" or "SPRINT" end
end)
